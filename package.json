{
    "name": "code-groovy",
    "displayName": "Code Groovy",
    "description": "Groovy and GSP support for VS Code and Cursor",
    "version": "0.2.2",
    "publisher": "marlon407",
    "license": "MIT",
    "engines": {
        "vscode": "^1.74.0",
        "node": ">=24"
    },
    "categories": [
        "Programming Languages"
    ],
    "keywords": [
        "groovy",
        "grails",
        "micronaut",
        "search code"
    ],
    "icon": "groovy.png",
    "activationEvents": [
        "workspaceContains:**/*.groovy",
        "workspaceContains:**/grails-app/**",
        "onCommand:cgroovy.organizeImports",
        "onCommand:cgroovy.organizeDependences",
        "onCommand:cgroovy.debugApp",
        "onLanguage:groovy",
        "onLanguage:gsp",
        "onDebugResolve:groovy",
        "onDebugDynamicConfigurations:groovy",
        "onDebug"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/marlon407/code-groovy"
    },
    "main": "./out/extension",
    "extensionDependencies": [
        "vscode.html-language-features",
        "redhat.java",
        "vscjava.vscode-java-debug"
    ],
    "contributes": {
        "htmlLanguageParticipants": [
            {
                "languageId": "gsp",
                "autoInsert": true
            }
        ],
        "configurationDefaults": {
            "emmet.includeLanguages": {
                "gsp": "html"
            },
            "[groovy]": {
                "editor.links": true
            },
            "[gsp]": {
                "editor.snippetSuggestions": "top",
                "editor.links": true,
                "emmet.triggerExpansionOnTab": false,
                "emmet.showAbbreviationSuggestions": false,
                "emmet.showExpandedAbbreviation": "never"
            },
            "files.associations": {
                "*.groovy": "groovy",
                "*.gvy": "groovy",
                "*.gy": "groovy",
                "*.gsh": "groovy"
            }
        },
        "html": {
            "customData": [
                "./data/grails-gsp.html-data.json"
            ]
        },
        "configuration": {
            "title": "Code Groovy",
            "properties": {
                "codeGroovy.index.maxSourceFiles": {
                    "type": "number",
                    "default": 0,
                    "markdownDescription": "Maximum workspace `.groovy` / `.java` files to index when **not** using Grails module detection. `0` means no limit."
                },
                "codeGroovy.modules": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "default": [
                        "domain",
                        "web",
                        "api"
                    ],
                    "markdownDescription": "Gradle submodules to index when settings.gradle is found."
                },
                "codeGroovy.debug.attachTimeoutMs": {
                    "type": "number",
                    "default": 600000,
                    "markdownDescription": "Time to wait for Gradle (compile + bootRun) and the app JVM to open JDWP (default port 5005). First Grails launches often need several minutes."
                },
                "codeGroovy.debug.useBootRunDebugJvm": {
                    "type": "boolean",
                    "default": false,
                    "markdownDescription": "Pass `--debug-jvm` to `bootRun` (Spring Boot Gradle plugin). Leave **off** for most Grails projects — Gradle often exits with code 1; JDWP is injected via the init script instead."
                },
                "codeGroovy.debug.openBrowserOnReady": {
                    "type": "boolean",
                    "default": true,
                    "markdownDescription": "When Grails/Spring Boot finishes starting (log line + HTTP responds), open the app URL in the default browser."
                },
                "codeGroovy.debug.serverUrl": {
                    "type": "string",
                    "default": "",
                    "markdownDescription": "Optional app URL for readiness checks (e.g. `http://localhost:8080`). Leave empty to parse from Gradle output (`Grails application running at …`)."
                },
                "codeGroovy.debug.gradleConsole": {
                    "type": "string",
                    "enum": [
                        "rich",
                        "plain"
                    ],
                    "default": "rich",
                    "markdownDescription": "Gradle `--console` mode for **Groovy Debug** terminal output. Use **rich** for ANSI colors (Grails/Spring log levels). Use **plain** if your CI-style logs break with color codes."
                },
                "codeGroovy.importOrder.warnings": {
                    "type": "boolean",
                    "default": true,
                    "markdownDescription": "Show **Problems** warnings when Groovy `import` lines are not in the same order as **Organize imports** would use. Set to `false` to hide import-order warnings only (other diagnostics are unchanged)."
                }
            }
        },
        "commands": [
            {
                "command": "cgroovy.organizeImports",
                "title": "Organize imports"
            },
            {
                "command": "cgroovy.organizeDependences",
                "title": "Organize dependences"
            },
            {
                "command": "cgroovy.showIndexOutput",
                "title": "Show Code Groovy Index Output"
            },
            {
                "command": "cgroovy.rebuildIndex",
                "title": "Rebuild Code Groovy Index"
            },
            {
                "command": "cgroovy.debugApp",
                "title": "Debug Groovy / Grails Application"
            }
        ],
        "keybindings": [
            {
                "command": "cgroovy.organizeImports",
                "key": "ctrl+shift+o",
                "mac": "cmd+shift+o",
                "when": "editorLangId =~ /groovy|gsp/"
            },
            {
                "command": "cgroovy.organizeDependences",
                "key": "ctrl+shift+d",
                "mac": "cmd+shift+d",
                "when": "editorLangId =~ /groovy|gsp/"
            }
        ],
        "snippets": [
            {
                "language": "groovy",
                "path": "./snippets/groovy.json"
            }
        ],
        "languages": [
            {
                "id": "groovy",
                "aliases": [
                    "Groovy"
                ],
                "extensions": [
                    ".groovy",
                    ".gvy",
                    ".gy",
                    ".gsh"
                ],
                "firstLine": "^#!.*\\bgroovy\\b",
                "configuration": "./language-configuration-groovy.json"
            },
            {
                "id": "gsp",
                "aliases": [
                    "Groovy Server Pages"
                ],
                "extensions": [
                    ".gsp"
                ],
                "configuration": "./language-configuration-gsp.json"
            }
        ],
        "grammars": [
            {
                "language": "groovy",
                "scopeName": "source.groovy",
                "path": "./syntaxes/groovy.tmLanguage.json"
            },
            {
                "scopeName": "source.groovy.code-groovy.injection",
                "path": "./syntaxes/groovy.injection.tmLanguage.json",
                "injectTo": [
                    "source.groovy"
                ]
            },
            {
                "language": "gsp",
                "scopeName": "text.html.gsp",
                "path": "./syntaxes/gsp.tmLanguage",
                "embeddedLanguages": {
                    "source.css": "css",
                    "source.js": "javascript",
                    "source.groovy": "groovy"
                }
            },
            {
                "scopeName": "text.html.gsp.grails-mid-tag.injection",
                "path": "./syntaxes/gsp.grails-mid-tag.injection.tmLanguage.json",
                "injectTo": [
                    "text.html.gsp"
                ]
            }
        ],
        "breakpoints": [
            {
                "language": "groovy"
            }
        ],
        "debuggers": [
            {
                "type": "groovy",
                "label": "Groovy / Grails",
                "languages": [
                    "groovy"
                ],
                "configurationAttributes": {
                    "launch": {
                        "properties": {
                            "port": {
                                "type": [
                                    "number",
                                    "string"
                                ],
                                "default": 5005,
                                "description": "JDWP port of the app JVM (default 5005)."
                            },
                            "task": {
                                "type": "string",
                                "description": "Gradle task to run (default bootRun for Grails, run otherwise). Can be qualified, e.g. :web:bootRun."
                            },
                            "module": {
                                "type": "string",
                                "description": "Gradle submodule to run (default web in a Grails multi-module repo)."
                            },
                            "gradleArgs": {
                                "type": "array",
                                "items": {
                                    "type": "string"
                                },
                                "description": "Extra arguments passed to Gradle after the task name."
                            },
							"sourcePaths": {
								"type": "array",
								"items": {
									"type": "string"
								},
								"description": "Extra source directories for Groovy/Java mapping. Auto-detected when omitted."
							},
							"projectName": {
								"type": "string",
								"description": "Java project name used by Debugger for Java to evaluate expressions (defaults to the Gradle module, e.g. web)."
							},
                            "serverUrl": {
                                "type": "string",
                                "description": "App URL to probe and open when startup completes (overrides codeGroovy.debug.serverUrl)."
                            },
                            "openBrowserOnReady": {
                                "type": "boolean",
                                "description": "Open the browser when the app responds on serverUrl (default from codeGroovy.debug.openBrowserOnReady)."
                            }
                        }
                    },
                    "attach": {
                        "required": [
                            "port"
                        ],
                        "properties": {
                            "hostName": {
                                "type": "string",
                                "default": "localhost",
                                "description": "Host name or IP of the debuggee JVM."
                            },
                            "port": {
                                "type": [
                                    "number",
                                    "string"
                                ],
                                "default": 5005,
                                "description": "JDWP port of the debuggee JVM."
                            },
							"sourcePaths": {
								"type": "array",
								"items": {
									"type": "string"
								},
								"description": "Extra source directories for Groovy/Java mapping. Auto-detected when omitted."
							},
							"projectName": {
								"type": "string",
								"description": "Java project name used by Debugger for Java to evaluate expressions (defaults to the Gradle module, e.g. web)."
							}
                        }
                    }
                },
                "initialConfigurations": [
                    {
                        "type": "groovy",
                        "request": "launch",
                        "name": "Groovy: Launch Grails",
                        "port": 5005
                    },
                    {
                        "type": "groovy",
                        "request": "attach",
                        "name": "Groovy: Attach",
                        "hostName": "localhost",
                        "port": 5005
                    }
                ],
                "configurationSnippets": [
                    {
                        "label": "Groovy: Launch Grails / Micronaut",
                        "description": "Start the Gradle app with JDWP and attach the Java debugger",
                        "body": {
                            "type": "groovy",
                            "request": "launch",
                            "name": "Groovy: Launch Grails",
                            "port": 5005
                        }
                    },
                    {
                        "label": "Groovy: Attach to JVM",
                        "description": "Attach to a JVM already started with JDWP (port 5005)",
                        "body": {
                            "type": "groovy",
                            "request": "attach",
                            "name": "Groovy: Attach",
                            "hostName": "localhost",
                            "port": 5005
                        }
                    }
                ]
            }
        ]
    },
    "scripts": {
        "vscode:prepublish": "npm run compile",
        "compile": "tsc -p ./",
        "watch": "tsc -watch -p ./",
        "pretest": "npm run compile",
        "test:unit": "npm run compile && mocha --ui tdd 'out/test/unit/**/*.test.js'",
        "test": "npm run test:unit && node ./out/test/runTest.js"
    },
    "devDependencies": {
        "@types/mocha": "^10.0.10",
        "@types/node": "^24.13.3",
        "@types/vscode": "^1.74.0",
        "@vscode/test-electron": "^3.1.0",
        "@vscode/vsce": "^3.4.2",
        "mocha": "^12.0.0",
        "typescript": "^5.8.2"
    },
    "overrides": {
        "semver@5": "5.7.2"
    }
}
